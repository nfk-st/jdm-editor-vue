{
  "name": "@nfk.st/jdm-editor-vue",
  "version": "0.1.0",
  "description": "Vue 3 port of GoRules' JDM Editor — components for crafting and designing JDM (JSON Decision Model) files",
  "author": "nfk.st",
  "homepage": "https://github.com/nfk-st/goruleditor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nfk-st/goruleditor.git",
    "directory": "packages/jdm-editor-vue"
  },
  "bugs": {
    "url": "https://github.com/nfk-st/goruleditor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "keywords": [
    "decision-model",
    "rules-engine",
    "jdm",
    "gorules",
    "zen",
    "vue"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "build-storybook": "storybook build",
    "check:imports": "node scripts/check-named-imports.mjs",
    "check:dist": "node scripts/check-dist-import.mjs",
    "prepublishOnly": "vite build && node scripts/check-dist-import.mjs",
    "storybook": "storybook dev -p 6006",
    "typecheck": "vue-tsc --noEmit && node scripts/check-named-imports.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@vue/reactivity": "^3.5.13",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@gorules/lezer-zen": "0.8.1",
    "@gorules/lezer-zen-template": "0.4.0",
    "@gorules/zen-engine-wasm": "0.23.1",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.6",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.42.1",
    "@vueuse/core": "^12.8.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "fast-deep-equal": "^3.1.3",
    "immer": "^10.1.1",
    "json-stringify-pretty-compact": "^4.0.0",
    "json5": "^2.2.3",
    "lodash": "^4.17.21",
    "lucide-vue-next": "^0.488.0",
    "monaco-editor": "^0.52.2",
    "reka-ui": "^2.1.0",
    "splitpanes": "^3.1.5",
    "to-json-schema": "^0.2.5",
    "ts-pattern": "^5.7.0",
    "vue-draggable-plus": "^0.5.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@storybook/addon-actions": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/vue3": "^8.6.19",
    "@storybook/vue3-vite": "^8.6.12",
    "@types/big.js": "^6.2.2",
    "@types/lodash": "^4.17.16",
    "@types/to-json-schema": "^0.2.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "sass": "^1.86.3",
    "storybook": "^8.6.12",
    "vite": "^6.2.6",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.1.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  }
}
